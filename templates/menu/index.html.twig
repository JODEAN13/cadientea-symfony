{% extends 'base.html.twig' %}

{% block title %}Menu - CadienTea{% endblock %}

{% block stylesheets %}
<style>
    .stock-indicator {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.2rem 0.7rem;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }
    .stock-ok { background: #d1fae5; color: #065f46; }
    .stock-low { background: #fef3c7; color: #92400e; }
    .stock-out { background: #fee2e2; color: #991b1b; }
    .product-card.out-of-stock .menu-card-img img,
    .product-card.out-of-stock img { filter: grayscale(100%); opacity: 0.6; }
    .btn-add:disabled { opacity: 0.5; cursor: not-allowed; background: #ccc !important; color: #666 !important; }
</style>
{% endblock %}

{% block body %}
<section style="padding: 6rem 2rem 4rem; max-width: 1200px; margin: 0 auto;">
    <div class="section-head" style="text-align: center; margin-bottom: 2rem;">
        <div class="badge">🧋 Our Menu</div>
        <h1 style="color: #e91e63; font-family: 'Fredoka', sans-serif; margin-bottom: 1rem;">
            Signature Bubble Teas
        </h1>
        <p style="color: #5c3a43; max-width: 480px; margin: 0 auto;">Every sip tells a story. Fresh milk teas, fruity blends, popping pearls — made to order, made for you.</p>
    </div>

    {% if products is empty %}
        <p style="text-align: center;">No products available yet.</p>
    {% else %}
        <div class="menu-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 2rem;">
            {% for product in products %}
                {% set stock = product.stock %}
                {% set isOutOfStock = stock <= 0 %}
                
                <div class="product-card {% if isOutOfStock %}out-of-stock{% endif %}" style="background: white; border-radius: 12px; border: 1px solid #f5c6d8; box-shadow: 0 2px 16px rgba(245,15,184,0.06); overflow: hidden; display: flex; flex-direction: column;">
                    
                    <div style="position: relative; height: 220px; background: #fce8f1; overflow: hidden;">
                        {% if product.image %}
                            <img src="{{ asset(product.image) }}" alt="{{ product.name }}" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" />
                        {% else %}
                            <div style="display:flex; align-items:center; justify-content:center; height:100%; font-size: 4rem;">🧋</div>
                        {% endif %}

                        {% if product.tag %}
                            <span style="position: absolute; top: 0.75rem; left: 0.75rem; background: #ec008c; color: white; font-size: 0.7rem; font-weight: 700; padding: 0.25rem 0.7rem; border-radius: 999px; text-transform: uppercase;">
                                {{ product.tag }}
                            </span>
                        {% endif %}

                        {% if isOutOfStock %}
                            <span style="position: absolute; bottom: 0.75rem; left: 0.75rem; background: #dc2626; color: white; font-size: 0.7rem; font-weight: 700; padding: 0.25rem 0.7rem; border-radius: 999px;">
                                ❌ OUT OF STOCK
                            </span>
                        {% endif %}
                    </div>

                    <div style="padding: 1.25rem 1.5rem 1.5rem; flex: 1; display: flex; flex-direction: column;">
                        <h3 style="margin: 0 0 0.5rem; color: #1a0a10; font-family: 'Fredoka', sans-serif; font-size: 1.15rem;">{{ product.name }}</h3>
                        
                        {% if product.description %}
                            <p style="color: #666; font-size: 0.875rem; line-height: 1.6; margin-bottom: 1rem; flex: 1;">{{ product.description }}</p>
                        {% endif %}

                        {% if stock > 0 and stock <= 5 %}
                            <div class="stock-indicator stock-low">⚠️ Only {{ stock }} left!</div>
                        {% elseif stock > 5 %}
                            <div class="stock-indicator stock-ok">✅ {{ stock }} in stock</div>
                        {% endif %}

                        <form action="{{ path('app_cart_add', {'id': product.id}) }}" method="POST" style="margin-top: auto;">
                            <select name="size" style="width: 100%; padding: 0.6rem; border: 1px solid #f5c6d8; border-radius: 8px; margin-bottom: 0.75rem; font-family: 'Nunito', sans-serif;" {% if isOutOfStock %}disabled{% endif %}>
                                {% for size in product.productSizes %}
                                    <option value="{{ size.size }}">{{ size.size }} - ₱{{ size.price }}</option>
                                {% endfor %}
                            </select>
                            <div style="display: flex; gap: 0.5rem;">
                                <input type="number" name="quantity" value="1" min="1" max="{{ product.maxPerOrder }}" style="width: 70px; padding: 0.6rem; border: 1px solid #f5c6d8; border-radius: 8px; text-align: center;" {% if isOutOfStock %}disabled{% endif %} />
                                <button type="submit" class="btn-primary" style="flex: 1; padding: 0.6rem;" {% if isOutOfStock %}disabled{% endif %}>
                                    {% if isOutOfStock %}Out of Stock{% else %}Add to Cart 🛒{% endif %}
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}