{% extends 'base.html.twig' %}

{% block title %}Change Password – CadienTea{% endblock %}

{% block body %}
<div style="max-width: 500px; margin: 4rem auto; padding: 0 1.5rem; min-height: 50vh;">
    
    {# Flash Messages #}
    {% for message in app.flashes('error') %}
        <div style="background: #fee2e2; color: #991b1b; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-weight: 600;">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('success') %}
        <div style="background: #d1fae5; color: #065f46; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; font-weight: 600;">
            {{ message }}
        </div>
    {% endfor %}

    <div style="background: #fff; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden;">
        <div style="background: #2d3436; color: #fff; padding: 1.5rem;">
            <h2 style="margin: 0; font-family: 'Fredoka', sans-serif; font-size: 1.5rem;">Change Password</h2>
        </div>
        
        <div style="padding: 2rem;">
            <form method="post">
                {# CSRF Token for security (Rubric Requirement) #}
                <input type="hidden" name="_token" value="{{ csrf_token('change_password') }}">

                <div style="margin-bottom: 1.25rem;">
                    <label for="current_password" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: #2d3436;">Current Password</label>
                    <input type="password" class="form-input" id="current_password" name="current_password" required style="width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 8px; font-family: inherit;">
                </div>
                
                <div style="margin-bottom: 1.25rem;">
                    <label for="new_password" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: #2d3436;">New Password</label>
                    <input type="password" class="form-input" id="new_password" name="new_password" required minlength="6" style="width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 8px; font-family: inherit;">
                </div>

                <div style="margin-bottom: 1.25rem;">
                    <label for="confirm_password" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: #2d3436;">Confirm New Password</label>
                    <input type="password" class="form-input" id="confirm_password" name="confirm_password" required minlength="6" style="width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 8px; font-family: inherit;">
                </div>

                <div style="display: flex; justify-content: space-between; margin-top: 2rem;">
                    <a href="{{ path('app_profile') }}" class="btn-outline" style="text-decoration: none;">Cancel</a>
                    <button type="submit" class="btn-primary" style="border: none; cursor: pointer;">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}