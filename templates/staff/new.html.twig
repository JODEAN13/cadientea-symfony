{% extends 'base.html.twig' %}

{% block title %}Add Product - Staff{% endblock %}

{% block body %}
<div style="padding: 6rem 2rem 4rem; max-width: 700px; margin: 0 auto; min-height: 80vh;">
    <h1 style="color: #e91e63; font-family: 'Fredoka', sans-serif; margin-bottom: 2rem;">Add New Product</h1>

    <div style="background: white; border-radius: 12px; border: 1px solid #f5c6d8; padding: 2rem; box-shadow: 0 2px 16px rgba(236,0,140,0.05);">
        
        {# Show form-level errors #}
        {{ form_errors(form) }}

        {# 🔥 CRITICAL: enctype is needed for image uploads #}
        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
            
            {# Name #}
            <div style="margin-bottom: 1rem;">
                {{ form_label(form.name, 'Product Name *', {'label_attr': {'style': 'font-weight: 600; display: block; margin-bottom: 0.3rem; color: #1a0a10;'}}) }}
                {{ form_widget(form.name, {'attr': {'style': 'width: 100%; padding: 0.75rem; border: 1.5px solid #f5c6d8; border-radius: 8px; font-size: 0.95rem;'}}) }}
                {{ form_errors(form.name) }}
            </div>
            
            {# Category #}
            <div style="margin-bottom: 1rem;">
                {{ form_label(form.category, 'Category *', {'label_attr': {'style': 'font-weight: 600; display: block; margin-bottom: 0.3rem; color: #1a0a10;'}}) }}
                {{ form_widget(form.category, {'attr': {'style': 'width: 100%; padding: 0.75rem; border: 1.5px solid #f5c6d8; border-radius: 8px; font-size: 0.95rem;'}}) }}
                {{ form_errors(form.category) }}
            </div>

            {# Description #}
            <div style="margin-bottom: 1rem;">
                {{ form_label(form.description, 'Description', {'label_attr': {'style': 'font-weight: 600; display: block; margin-bottom: 0.3rem; color: #1a0a10;'}}) }}
                {{ form_widget(form.description, {'attr': {'style': 'width: 100%; padding: 0.75rem; border: 1.5px solid #f5c6d8; border-radius: 8px; font-size: 0.95rem; min-height: 80px;'}}) }}
                {{ form_errors(form.description) }}
            </div>

            {# Stock + Max Per Order #}
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                <div>
                    {{ form_label(form.stock, 'Stock *', {'label_attr': {'style': 'font-weight: 600; display: block; margin-bottom: 0.3rem; color: #1a0a10;'}}) }}
                    {{ form_widget(form.stock, {'attr': {'style': 'width: 100%; padding: 0.75rem; border: 1.5px solid #f5c6d8; border-radius: 8px; font-size: 0.95rem;'}}) }}
                    {{ form_errors(form.stock) }}
                </div>
                <div>
                    {{ form_label(form.maxPerOrder, 'Max Per Order *', {'label_attr': {'style': 'font-weight: 600; display: block; margin-bottom: 0.3rem; color: #1a0a10;'}}) }}
                    {{ form_widget(form.maxPerOrder, {'attr': {'style': 'width: 100%; padding: 0.75rem; border: 1.5px solid #f5c6d8; border-radius: 8px; font-size: 0.95rem;'}}) }}
                    {{ form_errors(form.maxPerOrder) }}
                </div>
            </div>

            {# Regular + Large Price #}
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                <div>
                    {{ form_label(form.priceRegular, 'Regular Price (₱)', {'label_attr': {'style': 'font-weight: 600; display: block; margin-bottom: 0.3rem; color: #1a0a10;'}}) }}
                    {{ form_widget(form.priceRegular, {'attr': {'style': 'width: 100%; padding: 0.75rem; border: 1.5px solid #f5c6d8; border-radius: 8px; font-size: 0.95rem;'}}) }}
                    {{ form_errors(form.priceRegular) }}
                </div>
                <div>
                    {{ form_label(form.priceLarge, 'Large Price (₱)', {'label_attr': {'style': 'font-weight: 600; display: block; margin-bottom: 0.3rem; color: #1a0a10;'}}) }}
                    {{ form_widget(form.priceLarge, {'attr': {'style': 'width: 100%; padding: 0.75rem; border: 1.5px solid #f5c6d8; border-radius: 8px; font-size: 0.95rem;'}}) }}
                    {{ form_errors(form.priceLarge) }}
                </div>
            </div>
            {# Tag #}
            <div style="margin-bottom: 1rem;">
                {{ form_label(form.tag, 'Tag (Optional)', {'label_attr': {'style': 'font-weight: 600; display: block; margin-bottom: 0.3rem; color: #1a0a10;'}}) }}
                {{ form_widget(form.tag, {'attr': {'style': 'width: 100%; padding: 0.75rem; border: 1.5px solid #f5c6d8; border-radius: 8px; font-size: 0.95rem;'}}) }}
                {{ form_errors(form.tag) }}
            </div>

            {# Image Upload #}
            <div style="margin-bottom: 1.5rem;">
                {{ form_label(form.image, 'Product Image', {'label_attr': {'style': 'font-weight: 600; display: block; margin-bottom: 0.3rem; color: #1a0a10;'}}) }}
                {{ form_widget(form.image, {'attr': {'style': 'width: 100%; padding: 0.75rem; border: 1.5px solid #f5c6d8; border-radius: 8px;'}}) }}
                <small style="color: #8a4a60; font-size: 0.8rem;">Max 2MB · JPG, PNG, or WEBP</small>
                {{ form_errors(form.image) }}
            </div>

            <button type="submit" class="btn-primary" style="width: 100%; padding: 0.9rem; font-size: 1rem;">Save Product 🧋</button>
            
            <a href="{{ path('app_staff_dashboard') }}" style="display: block; text-align: center; margin-top: 1rem; color: #8a4a60; text-decoration: none; font-size: 0.9rem;">Cancel</a>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}