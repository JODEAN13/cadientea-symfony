{% extends 'base.html.twig' %}

{% block title %}Community – CadienTea{% endblock %}

{% block body %}
<section id="community" style="padding-top: 100px; min-height: 100vh;">
    <div class="section-inner">
        <div class="section-head">
            <div class="badge">💬 Community Love</div>
            <h2>What our community says</h2>
        </div>
        <div class="testi-grid">
            <div class="testi-card">
                <div class="testi-stars">★★★★★</div>
                <blockquote>"CadienTea is my daily ritual. The Brown Sugar Tiger is unreal — perfectly chewy pearls and that caramel swirl just hits different every time."</blockquote>
                <div class="testi-author">
                    <div class="testi-avatar">Y</div>
                    <span class="name">Yah T.</span>
                </div>
            </div>
            <div class="testi-card">
                <div class="testi-stars">★★★★★</div>
                <blockquote>"Best bubble tea I have had outside of Taiwan. The pearls are always fresh and the staff genuinely care. This place is special."</blockquote>
                <div class="testi-author">
                    <div class="testi-avatar">P</div>
                    <span class="name">Puh K.</span>
                </div>
            </div>
            <div class="testi-card">
                <div class="testi-stars">★★★★★</div>
                <blockquote>"I came for the Pink Lychee Boba and I cannot stop coming back. The vibes, the flavours, the whole experience — it is my happy place."</blockquote>
                <div class="testi-author">
                    <div class="testi-avatar">K</div>
                    <span class="name">Kissie E.</span>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}