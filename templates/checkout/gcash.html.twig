{% extends 'base.html.twig' %}

{% block title %}GCash Payment - CadienTea{% endblock %}

{% block body %}
<div style="padding: 6rem 2rem 4rem; max-width: 400px; margin: 0 auto; text-align: center;">
    
    <div style="background: #007dfe; color: white; border-radius: 12px 12px 0 0; padding: 1.5rem; text-align: center;">
        <div style="background: white; color: #007dfe; width: 40px; height: 40px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 800; margin-bottom: 0.5rem;">G</div>
        <h2 style="margin: 0; font-family: 'Fredoka', sans-serif;">GCash</h2>
        <p style="margin: 0.25rem 0 0; font-size: 0.85rem; opacity: 0.9;">Express Send</p>
    </div>

    <div style="background: white; border-radius: 0 0 12px 12px; padding: 2rem; box-shadow: 0 4px 16px rgba(0,0,0,0.1);">
        <p style="color: #666; margin-bottom: 0.5rem;">Amount to pay</p>
        <h1 style="color: #007dfe; font-size: 2.5rem; margin: 0 0 2rem;">₱{{ order.totalAmount }}</h1>
        
        <form method="POST">
            <div style="text-align: left; margin-bottom: 1rem;">
                <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; font-size: 0.9rem;">GCash Number</label>
                <input 
                    type="tel" 
                    name="gcash_number" 
                    placeholder="09XX XXX XXXX" 
                    required 
                    maxlength="11"
                    pattern="[0-9]{11}"
                    style="width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem;">
            </div>
            
            <div style="text-align: left; margin-bottom: 1rem;">
                <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; font-size: 0.9rem;">MPIN (4 digits)</label>
                <input 
                    type="password" 
                    name="mpin" 
                    placeholder="••••" 
                    required 
                    maxlength="4"
                    pattern="[0-9]{4}"
                    inputmode="numeric"
                    style="width: 100%; padding: 0.8rem; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem;">
            </div>
            
            <button type="submit" style="width: 100%; padding: 1rem; background: #007dfe; color: white; border: none; border-radius: 6px; font-weight: bold; font-size: 1.1rem; cursor: pointer;">
                🔒 Pay ₱{{ order.totalAmount }}
            </button>
        </form>
        
        <p style="color: #999; font-size: 0.7rem; margin-top: 1rem;">This is a simulation for educational purposes only.</p>
    </div>
</div>
{% endblock %}